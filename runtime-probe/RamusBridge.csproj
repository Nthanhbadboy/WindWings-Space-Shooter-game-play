<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ramus Runtime Bridge — one project, three loaders.

      dotnet build -p:Loader=BepInEx6   -p:BepInExRoot="<game>/BepInEx"
      dotnet build -p:Loader=BepInEx5   -p:UnityManagedDir="<game>_Data/Managed"
      dotnet build -p:Loader=MelonLoader -p:MelonDir="<MelonLoader>"

    The core (RamusBridge.cs) has zero third-party dependencies; it only needs
    the Unity assemblies the loader already ships with.
  -->

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>RamusBridge</AssemblyName>
    <RootNamespace>Ramus.Bridge</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <Loader Condition="'$(Loader)' == ''">BepInEx6</Loader>
    <InteropDir Condition="'$(InteropDir)' == ''">$(BepInExRoot)/interop</InteropDir>
    <MelonInteropDir Condition="'$(MelonInteropDir)' == ''">$(MelonDir)/Il2CppInterop</MelonInteropDir>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RamusBridge.cs" />
    <Compile Include="Adapters/$(Loader)/*.cs" />
  </ItemGroup>

  <!-- BepInEx 6 (IL2CPP): CoreCLR host on Android (FusionCore / BepInEx.Android). -->
  <ItemGroup Condition="'$(Loader)' == 'BepInEx6'">
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExRoot)/core/BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExRoot)/core/BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExRoot)/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(InteropDir)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Interop assemblies generated by BepInEx for the target game. -->
    <Reference Include="$(InteropDir)/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- BepInEx 5 (Mono) / desktop players. -->
  <ItemGroup Condition="'$(Loader)' == 'BepInEx5'">
    <Reference Include="BepInEx">
      <HintPath>$(BepInExRoot)/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExRoot)/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(UnityManagedDir)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(UnityManagedDir)/UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- MelonLoader / LemonLoader (Android IL2CPP). -->
  <ItemGroup Condition="'$(Loader)' == 'MelonLoader'">
    <Reference Include="MelonLoader">
      <HintPath>$(MelonDir)/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonDir)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(MelonInteropDir)/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
