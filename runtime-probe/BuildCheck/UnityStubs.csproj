<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Produces a stub `UnityEngine.dll` so the bridge can be compiled without Unity.

    The assembly name and version matter: BepInEx 5's BepInEx.dll references
    `UnityEngine, Version=0.0.0.0` (that is what CS0012 reported), so the stub
    must present exactly that identity or the adapter cannot be type-checked.

    This assembly is a build-time artefact only — it is never deployed.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>UnityEngine</AssemblyName>
    <RootNamespace>UnityEngine</RootNamespace>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <Version>0.0.0.0</Version>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
  </ItemGroup>

</Project>
